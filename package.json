{
  "name": "opencode-bifrost-plugin",
  "displayName": "Bifrost opencode Plugin",
  "description": "opencode LLM provider for a self-hosted Bifrost gateway, with automatic model and context-size discovery.",
  "version": "0.4.1",
  "publisher": "Yeti47",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yeti47/opencode-bifrost-plugin.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "bifrost",
    "llm",
    "ai"
  ],
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.5"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.5",
    "@types/node": "22.20.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
